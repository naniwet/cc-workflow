# macOS
.DS_Store

# Python (for future backend/)
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# Editor
.vscode/
.idea/
*.swp
*.swo

# State / secrets — these live in ~/.cc-workflow/ and ~/.cc-state/ on the
# server, NEVER in the repo. Listed here as a safety net in case anyone
# accidentally creates them inside the project root.
secrets.toml
providers.json
.cc-workflow/
.cc-state/

# Local Claude Code workspace state (settings.local.json captures the
# user's machine-specific allowlist with absolute paths; skills under
# .claude/skills/ are project-private experiments)。
# Exception: .claude/agents/ — project-shared subagent definitions
# (code-dev / code-review),要进 git 跟人走。
# 注意:gitignore 不允许在被忽略的"目录"下 re-include 文件,所以这里
# 列具体子项忽略而不是整个 .claude/。
.claude/*
!.claude/agents/

# Misc local scratch dirs — never project artifacts.
packages/
