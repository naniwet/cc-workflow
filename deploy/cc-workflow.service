[Unit]
Description=cc-workflow backend (FastAPI on 0.0.0.0:8765 — Phase 1 direct expose)
After=network.target

[Service]
Type=simple
# Replace <user> with the actual login user on the server (e.g. ubuntu, root).
# If running as root, set HOME-based paths to /root/projects/cc-workflow.
User=<user>
WorkingDirectory=/home/<user>/projects/cc-workflow
# Uses the project-local venv (PEP 668 — Ubuntu 24.04+ blocks system pip).
# Setup once:  python3 -m venv .venv && .venv/bin/pip install fastapi uvicorn pydantic tomli
#
# Bind 0.0.0.0 in Phase 1 to let Mac browser hit http://<server-public-ip>:8765/
# directly. NO AUTH yet — protect via cloud-provider security group (allowlist
# your home/office egress IP). Phase 3 switches back to 127.0.0.1 + nginx
# reverse proxy + HTTPS + basic auth + CSRF (dev-plan §5 step 26-27).
ExecStart=/home/<user>/projects/cc-workflow/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
