[Unit]
Description=cc-workflow backend (FastAPI on 127.0.0.1:8765, fronted by nginx :80)
Documentation=https://github.com/naniwet/cc-workflow/blob/main/deploy/INSTALL.md
After=network.target
# Soft dependency on cron — we write /etc/cron.d/cc-loops; if cron isn't there,
# the file just sits inert until cron is installed. No need to require it.

[Service]
Type=simple

# Backend launches as root. trust=on edge cases (writes to ~/.claude/,
# some file-modifying Bash commands per claude-code#20449) hit
# claude's L1 permission block and can't be auto-approved — for those
# specific operations you SSH in and run them by hand. The global allow
# list at ~/.claude/settings.json (planted by ws_settings.sync_global_-
# allow_rules at startup) + the PreToolUse hook still cover ~95% of
# trust=on use cases.
#
# Non-root deployment options exist (scripts/migrate-grant-acl.sh,
# deploy/MIGRATE-TO-NONROOT.md) but are EXPERIMENTAL — known to cause
# backend instability on some setups (root cause not fully pinned).
# Don't switch unless you've hit the edge case repeatedly and read
# both docs first. Easy rollback if it goes wrong: flip User= back to
# root and restart.
User=root
WorkingDirectory=/root/projects/cc-workflow

# Project-local venv — Ubuntu 24.04+ blocks system-wide pip (PEP 668).
# First-time setup (as the ccw user after chown):
#   sudo -u ccw python3 -m venv .venv
#   sudo -u ccw .venv/bin/pip install fastapi uvicorn pydantic tomli cryptography
# (cryptography is only needed if Feishu Encrypt Key is configured.)
#
# Bind 127.0.0.1 — public traffic comes through nginx on :80. HMAC session
# cookie auth is enforced at the FastAPI layer (backend/auth.py).
ExecStart=/root/projects/cc-workflow/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8765

# Restart policy — recover from transient crashes, give up after a real
# crash loop so journalctl shows something other than an endless retry.
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Logging — single tag so `journalctl -t cc-workflow` works regardless of
# how the unit was loaded.
SyslogIdentifier=cc-workflow

# Security hardening (defense in depth — won't help against an exploit in
# our own code that runs as root, but blocks common privilege escalation).
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Don't ProtectSystem=strict — we need to write /etc/cron.d/cc-loops.
# Don't ProtectHome=true — we read/write /root/.cc-workflow + /root/.cc-state.

[Install]
WantedBy=multi-user.target
